# Supabase — use o MESMO projeto que a Zoe (o bot) já usa
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=sua_service_role_key_do_supabase

# String aleatória grande, só pra assinar o cookie de login (invente qualquer coisa longa)
SESSION_SECRET=troque_por_uma_string_bem_grande_e_aleatoria

# Login do admin deste painel (não é o mesmo do servidor Discord)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=escolha_uma_senha_forte

# Segredo compartilhado entre este site e o BOT (mesmo valor dos dois lados)
BOT_SHARED_SECRET=troque_por_outra_string_aleatoria

# Endereço do bot rodando no Railway (ou onde ele estiver)
BOT_API_URL=https://seu-bot.up.railway.app

# OAuth2 do Discord (Discord Developer Portal → sua aplicação → OAuth2)
DISCORD_CLIENT_ID=id_da_aplicacao
DISCORD_CLIENT_SECRET=segredo_da_aplicacao
DISCORD_REDIRECT_URI=https://seu-site.vercel.app/api/auth/discord/callback

# Chave que criptografa as autorizações OAuth2 guardadas no banco (string longa e aleatória).
# Use o MESMO valor aqui e no site Crimson Beams X. Se perder essa chave, as autorizações salvas ficam inúteis.
TOKEN_ENC_KEY=troque_por_uma_string_bem_grande_e_aleatoria

# Token do bot (Discord Developer Portal > Bot > Reset Token). Usado para puxar membros para outro servidor
# direto pela API do Discord, sem depender do processo do bot estar no ar.
DISCORD_BOT_TOKEN=token_do_bot_zoe
